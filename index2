<body>
<div id="box">
    <h2>📘 刷题系统（内置题库）</h2>
    <p class="subtitle">题库已内置 · 搜索跳转 · 错题复习 · 题型筛选</p>
    <div id="preview"></div>

    <div class="btn-row">
        <button class="primary" onclick="startQuiz()">▶ 开始刷题</button>
        <button id="btnRandom" onclick="toggleRandom()">🎲 随机模式</button>
        <button id="btnReview" class="success-btn" onclick="startReviewMode()">🔄 错题复习</button>
        <button onclick="toggleWrongBookPanel()">📋 错题本 <span id="wrongBadge" class="badge" style="display:none;">0</span></button>
        <button onclick="clearWrongBook()" class="warn">🗑 清空错题</button>
    </div>

    <div class="filter-row">
        <span style="font-weight:600;">📚 题型：</span>
        <button id="filterAll" class="active-toggle" onclick="setTypeFilter('all')">全部</button>
        <button id="filterSingle" onclick="setTypeFilter('single')">单选题</button>
        <button id="filterMulti" onclick="setTypeFilter('multi')">多选题</button>
        <button id="filterJudge" onclick="setTypeFilter('judge')">判断题</button>
    </div>

    <div class="jump-row">
        <span>🎯 章节-题号跳转：</span>
        <input type="text" id="jumpInput" placeholder="如: 1-10 或 10" onkeydown="if(event.key==='Enter')jumpByNumber()">
        <button onclick="jumpByNumber()" class="primary">GO</button>
    </div>

    <div class="search-row">
        <input type="text" id="searchInput" placeholder="🔍 关键词/题号搜索..." oninput="onSearchInput()" onkeydown="if(event.key==='Enter')doSearchJump()">
        <button onclick="doSearchJump()">搜索</button>
        <div class="search-suggestions" id="searchSuggestions"></div>
    </div>


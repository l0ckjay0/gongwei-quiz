<script>
    // 内置题库
    const EMBEDDED_QUESTIONS = ${embeddedQuestions};

    // ==================== 核心代码（与母版一致，但无导入功能） ====================
    let questions = EMBEDDED_QUESTIONS.map(q => ({...q, id: String(q.id)}));
    let displayOrder = [...Array(questions.length).keys()];
    let currentDisplayIndex = 0;
    let isRandomMode = false;
    let isReviewMode = false;
    let typeFilter = 'all';
    let wrongBook = new Set();
    let answered = false;
    const STORAGE_KEY = 'quiz_wrong_book_embedded';

    // 初始化错题本
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) wrongBook = new Set(JSON.parse(raw).map(String));
    } catch (e) {}
    updateBadge();

    function saveWrongBook() { localStorage.setItem(STORAGE_KEY, JSON.stringify([...wrongBook])); updateBadge(); }
    function updateBadge() {
        const badge = document.getElementById('wrongBadge');
        badge.style.display = wrongBook.size > 0 ? 'inline-block' : 'none';
        badge.textContent = wrongBook.size;
        if (wrongBook.size === 0 && isReviewMode) exitReviewMode();
    }

    const counts = { single: 0, multi: 0, judge: 0 };
    questions.forEach(q => { if (counts[q.type] !== undefined) counts[q.type]++; });
    document.getElementById('preview').innerHTML = \`📚 已加载题库：单选 \${counts.single} | 多选 \${counts.multi} | 判断 \${counts.judge} | 共 \${questions.length} 题\`;

    // 以下复制主程序中所有函数（setTypeFilter、rebuildDisplayOrder、showQ、checkAnswer... 保持完全一致）
    function setTypeFilter(type) {
        typeFilter = type;
        updateTypeFilterButtons();
        rebuildDisplayOrder();
        currentDisplayIndex = 0;
        answered = false;
        if (document.getElementById('quiz').style.display !== 'none') showQ();
    }
    function updateTypeFilterButtons() {
        ['all','single','multi','judge'].forEach(t => {
            const btn = document.getElementById('filter' + t.charAt(0).toUpperCase() + t.slice(1));
            if (btn) btn.classList.toggle('active-toggle', typeFilter === t);
        });
    }
    function rebuildDisplayOrder() {
        let indices = [...Array(questions.length).keys()];
        if (typeFilter !== 'all') indices = indices.filter(i => questions[i].type === typeFilter);
        if (isReviewMode) indices = indices.filter(i => wrongBook.has(questions[i].id));
        displayOrder = indices;
        if (isRandomMode) {
            for (let i = displayOrder.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [displayOrder[i], displayOrder[j]] = [displayOrder[j], displayOrder[i]];
            }
        }
        if (currentDisplayIndex >= displayOrder.length) currentDisplayIndex = 0;
    }
    function refreshReviewOrder() { rebuildDisplayOrder(); if (displayOrder.length === 0 && isReviewMode) exitReviewMode(); if (document.getElementById('quiz').style.display !== 'none') showQ(); }
    function getCurrentQuestion() { return displayOrder.length ? questions[displayOrder[currentDisplayIndex]] : null; }

    function showQ() {
        const q = getCurrentQuestion();
        if (!q) { document.getElementById('quiz').style.display = 'none'; return; }
        document.getElementById('quiz').style.display = 'block';
        answered = false;
        document.getElementById('progressBar').style.width = ((currentDisplayIndex) / displayOrder.length * 100) + '%';
        document.getElementById('qtitle').innerText = q.question;
        document.getElementById('qIdLabel').textContent = '题号：' + q.id;
        const typeTag = document.getElementById('qTypeTag');
        typeTag.className = 'q-type-tag ' + q.type;
        typeTag.textContent = q.type === 'judge' ? '判断题' : (q.type === 'multi' ? '多选题' : '单选题');
        const submitBtn = document.getElementById('submitBtn');
        let html = '';
        const keys = Object.keys(q.options).sort();
        if (q.type === 'multi') {
            submitBtn.style.display = 'inline-block';
            (keys.length ? keys : ['A','B','C','D','E']).forEach(k => {
                html += \`<label class="option" data-value="\${k}"><input type="checkbox" name="a" value="\${k}"> <b>\${k}.</b> \${q.options[k] || '(选项未解析)'}</label>\`;
            });
        } else if (q.type === 'judge') {
            submitBtn.style.display = 'none';
            html += '<label class="option" data-value="正确"><input type="radio" name="a" value="正确" onchange="autoCheck(this)"> ✅ 正确</label>';
            html += '<label class="option" data-value="错误"><input type="radio" name="a" value="错误" onchange="autoCheck(this)"> ❌ 错误</label>';
        } else {
            submitBtn.style.display = 'none';
            (keys.length ? keys : ['A','B','C','D','E']).forEach(k => {
                html += \`<label class="option" data-value="\${k}"><input type="radio" name="a" value="\${k}" onchange="autoCheck(this)"> <b>\${k}.</b> \${q.options[k] || '(选项未解析)'}</label>\`;
            });
        }
        document.getElementById('options').innerHTML = html;
        document.getElementById('result').innerHTML = '';
        document.getElementById('result').className = '';
        document.getElementById('qCounter').textContent = (currentDisplayIndex + 1) + ' / ' + displayOrder.length;
        document.getElementById('qCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function autoCheck(el) { if (!answered) checkAnswer(el.value); }
    function submitMultiChoice() {
        const checked = [...document.querySelectorAll('#options input[type="checkbox"]:checked')].map(cb => cb.value).sort().join(',');
        checkAnswer(checked);
    }
    function checkAnswer(userValue) {
        const q = getCurrentQuestion();
        if (!q || answered) return;
        answered = true;
        const correct = q.answer;
        const isCorrect = (userValue === correct);
        document.querySelectorAll('#options .option').forEach(label => {
            label.classList.remove('correct-highlight','wrong-highlight','correct-answer-reveal');
            const val = label.getAttribute('data-value');
            if (q.type === 'multi') {
                const selected = [...document.querySelectorAll('#options input[type="checkbox"]:checked')].map(cb => cb.value);
                if (selected.includes(val) && correct.split(',').includes(val)) label.classList.add('correct-highlight');
                else if (selected.includes(val) && !correct.split(',').includes(val)) label.classList.add('wrong-highlight');
                else if (!selected.includes(val) && correct.split(',').includes(val)) label.classList.add('correct-answer-reveal');
            } else {
                if (val === userValue && isCorrect) label.classList.add('correct-highlight');
                else if (val === userValue && !isCorrect) label.classList.add('wrong-highlight');
                else if (val === correct && !isCorrect) label.classList.add('correct-answer-reveal');
            }
        });
        const resultEl = document.getElementById('result');
        if (isCorrect) {
            resultEl.innerHTML = '✅ 回答正确！';
            resultEl.className = 'correct';
            if (wrongBook.has(q.id)) { wrongBook.delete(q.id); saveWrongBook(); }
        } else {
            resultEl.innerHTML = '❌ 回答错误，正确答案：<b>' + correct + '</b>';
            resultEl.className = 'wrong';
            if (!wrongBook.has(q.id)) { wrongBook.add(q.id); saveWrongBook(); }
        }
        if (isReviewMode) refreshReviewOrder();
    }
    function nextQ() { if (displayOrder.length) { currentDisplayIndex = (currentDisplayIndex + 1) % displayOrder.length; showQ(); } }
    function prevQ() { if (displayOrder.length) { currentDisplayIndex = (currentDisplayIndex - 1 + displayOrder.length) % displayOrder.length; showQ(); } }
    function toggleRandom() { isRandomMode = !isRandomMode; document.getElementById('btnRandom').classList.toggle('active-toggle', isRandomMode); document.getElementById('btnRandom').textContent = isRandomMode ? '🎲 随机模式 ✓' : '🎲 随机模式'; rebuildDisplayOrder(); currentDisplayIndex = 0; answered = false; if (document.getElementById('quiz').style.display !== 'none') showQ(); }
    function startReviewMode() { if (wrongBook.size === 0) { showToast('错题本为空'); return; } isReviewMode = true; isRandomMode = false; document.getElementById('btnRandom').classList.remove('active-toggle'); document.getElementById('btnRandom').textContent = '🎲 随机模式'; document.getElementById('btnReview').classList.add('active-toggle'); document.getElementById('btnReview').textContent = '🔄 错题复习中...'; rebuildDisplayOrder(); if (displayOrder.length === 0) { exitReviewMode(); return; } currentDisplayIndex = 0; answered = false; document.getElementById('quiz').style.display = 'block'; document.getElementById('wrongBookPanel').style.display = 'none'; showQ(); }
    function exitReviewMode() { isReviewMode = false; document.getElementById('btnReview').classList.remove('active-toggle'); document.getElementById('btnReview').textContent = '🔄 错题复习'; rebuildDisplayOrder(); currentDisplayIndex = 0; answered = false; if (document.getElementById('quiz').style.display !== 'none') showQ(); }
    function toggleWrongBookPanel() { const p = document.getElementById('wrongBookPanel'); if (p.style.display === 'block') p.style.display = 'none'; else { renderWrongBookPanel(); p.style.display = 'block'; } }
    function renderWrongBookPanel() {
        const list = document.getElementById('wrongBookList');
        document.getElementById('wbCountLabel').textContent = '共 ' + wrongBook.size + ' 题';
        if (wrongBook.size === 0) { list.innerHTML = '<div class="wb-empty">🎉 错题本为空</div>'; return; }
        let html = '';
        [...wrongBook].sort((a,b) => { const [ca,ia]=a.split('-').map(Number); const [cb,ib]=b.split('-').map(Number); return ca-cb||ia-ib; }).forEach(uid => {
            const q = questions.find(q=>q.id===uid);
            html += \`<div class="wb-item" onclick="jumpToQuestionById('\${uid}')"><span class="wb-id">#\${uid}</span>\${q?(q.type==='multi'?'[多选]':q.type==='judge'?'[判断]':'[单选]'):''} \${q?q.question.substring(0,45):'(不存在)'}</div>\`;
        });
        list.innerHTML = html;
    }
    function clearWrongBook() { if (confirm('确定清空所有错题记录？')) { wrongBook.clear(); saveWrongBook(); toggleWrongBookPanel(); if (isReviewMode) exitReviewMode(); } }
    function jumpToQuestionById(uid) {
        const idx = questions.findIndex(q => q.id === uid);
        if (idx === -1) { showToast('⚠️ 题目不存在'); return; }
        if (isReviewMode) exitReviewMode();
        if (typeFilter !== 'all') { typeFilter = 'all'; updateTypeFilterButtons(); }
        rebuildDisplayOrder();
        let dispIdx = displayOrder.indexOf(idx);
        if (dispIdx === -1) { displayOrder = [idx]; dispIdx = 0; }
        currentDisplayIndex = dispIdx;
        answered = false;
        document.getElementById('quiz').style.display = 'block';
        document.getElementById('wrongBookPanel').style.display = 'none';
        showQ();
        showToast('📍 已跳转到 #' + uid);
    }
    function jumpByNumber() {
        const input = document.getElementById('jumpInput').value.trim();
        if (!input) return;
        if (input.includes('-')) jumpToQuestionById(input);
        else {
            const matches = questions.filter(q => q.id.endsWith('-' + input) || q.originalId === input);
            if (matches.length === 1) jumpToQuestionById(matches[0].id);
            else if (matches.length > 1) {
                let h = ''; matches.forEach(q => h += \`<div class="item" onclick="jumpToQuestionById('\${q.id}');document.getElementById('searchSuggestions').classList.remove('show');"><span class="qid">#\${q.id}</span>\${q.question.substring(0,30)}</div>\`);
                const s = document.getElementById('searchSuggestions'); s.innerHTML = h; s.classList.add('show');
                showToast('⚠️ 多个章节存在该题号，请点击选择');
            } else showToast('⚠️ 未找到题号 ' + input);
        }
        document.getElementById('jumpInput').value = '';
    }
    function onSearchInput() {
        const input = document.getElementById('searchInput').value.trim();
        const sug = document.getElementById('searchSuggestions');
        if (!input || questions.length === 0) { sug.classList.remove('show'); return; }
        const kw = input.toLowerCase();
        const results = questions.filter(q => q.id.toLowerCase().includes(kw) || q.question.toLowerCase().includes(kw) || Object.values(q.options).some(o => o.toLowerCase().includes(kw)));
        if (results.length === 0) { sug.innerHTML = '<div class="item" style="color:#9ca3af;">未找到匹配题目</div>'; sug.classList.add('show'); return; }
        let html = ''; results.slice(0,15).forEach(q => { const pre = q.question.substring(0,35)+(q.question.length>35?'...':''); html += \`<div class="item" data-id="\${q.id}"><span class="qid">#\${q.id}</span> \${pre}</div>\`; });
        sug.innerHTML = html; sug.classList.add('show');
        sug.querySelectorAll('.item').forEach(item => { item.addEventListener('click', function(){ const id = this.getAttribute('data-id'); if(id){ jumpToQuestionById(id); sug.classList.remove('show'); document.getElementById('searchInput').value = ''; } }); });
    }
    function doSearchJump() {
        const input = document.getElementById('searchInput').value.trim();
        if (!input) return;
        if (input.includes('-')) { jumpToQuestionById(input); document.getElementById('searchInput').value = ''; document.getElementById('searchSuggestions').classList.remove('show'); }
        else if (/^\d+$/.test(input)) { const matches = questions.filter(q => q.id.endsWith('-' + input) || q.originalId === input); if (matches.length === 1) { jumpToQuestionById(matches[0].id); document.getElementById('searchInput').value = ''; document.getElementById('searchSuggestions').classList.remove('show'); } else onSearchInput(); }
        else onSearchInput();
    }
    document.addEventListener('click', e => { const sug = document.getElementById('searchSuggestions'); if (!sug.contains(e.target) && e.target !== document.getElementById('searchInput')) sug.classList.remove('show'); });
    function startQuiz() { isReviewMode = false; isRandomMode = false; document.getElementById('btnRandom').classList.remove('active-toggle'); document.getElementById('btnRandom').textContent = '🎲 随机模式'; document.getElementById('btnReview').classList.remove('active-toggle'); document.getElementById('btnReview').textContent = '🔄 错题复习'; rebuildDisplayOrder(); currentDisplayIndex = 0; answered = false; document.getElementById('quiz').style.display = 'block'; document.getElementById('wrongBookPanel').style.display = 'none'; showQ(); }
    function showToast(msg) { const old = document.querySelector('.toast'); if (old) old.remove(); const t = document.createElement('div'); t.className = 'toast'; t.textContent = msg; document.body.appendChild(t); setTimeout(() => t.remove(), 2000); }
</script>
</body>
</html>`;

        // 创建Blob并下载
        const blob = new Blob([htmlContent], { type: 'text/html' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = '刷题系统_内置题库.html';
        a.click();
        showToast('📄 已导出为包含题库的独立HTML文件');
    }

    function showToast(msg) {
        const old = document.querySelector('.toast');
        if (old) old.remove();
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2000);
    }

    // 启动
    loadWrongBook();
    updateRandomButtonUI();
    updateReviewButtonUI();
    updateTypeFilterButtons();
</script>
